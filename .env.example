# Raksha-Drishti — build/runtime configuration.
# Copy to .env.local. All are OPTIONAL — with none set, the app builds and hosts
# using the bundled sample data (src/lib/data.ts) and no auth gate.

# Base URL of the deployed Catalyst rd_api Function. When set, district stats
# and the dashboard summary are served live from the FIR Data Store; otherwise
# the app falls back to the bundled sample data.
# e.g. https://rakshadrishti-<id>.development.catalystserverless.com/server/rd_api
NEXT_PUBLIC_RD_API_BASE=

# Set to "on" to require Catalyst officer sign-in (AuthGate). Requires
# Authentication enabled in the Catalyst console and the web SDK served with the
# client. Leave unset/"off" to keep the site open (default).
NEXT_PUBLIC_RD_AUTH=off
